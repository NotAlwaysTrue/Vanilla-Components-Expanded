<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);CLIENT</DefineConstants>
    <BuildTarget>Client</BuildTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\Shaders\NightVision.DirectX_11.mgfx" LogicalName="VCE.NightVision.mgfx" Condition="'$(PlatformName)' == 'Windows'" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\Shaders\NightVision.OpenGL.mgfx" LogicalName="VCE.NightVision.mgfx" Condition="'$(PlatformName)' != 'Windows'" />
  </ItemGroup>

  <Import Project="..\BuildData.props" />

  <Import Project="..\SharedProject\SharedProject.projitems" Label="Shared" />
  <Import Project="..\SharedProject\SharedItems.props" />

  <PropertyGroup>
    <RootNamespace>$(ModName)</RootNamespace>
    <AssemblyName>$(ModName)$(BuildTarget)</AssemblyName>
  </PropertyGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <FilesToCopy Include="$(TargetDir)$(TargetName).dll" />
      <FilesToCopy Include="$(TargetDir)$(TargetName).deps.json" />
      <FilesToCopy Include="$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(ModOutputDir)" />
  </Target>

  <Import Project="..\ModFiles.props" />
  <Import Project="..\CopyOtherFiles.props" />
</Project>
